# This app takes the Groq API key from the user in-browser (the /api-key step),
# not from the environment. These two vars only affect OpenTelemetry export and are optional.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=agentic-rag-lit-review

# Optional: override the Flask session signing key (otherwise a random one is generated per
# process start, which invalidates sessions on restart -- fine for local demo use).
FLASK_SECRET_KEY=

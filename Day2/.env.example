# Environment Configuration Template
# Copy this file to .env and .env.production with appropriate values

# Application Configuration
VITE_APP_NAME=ALCOA+ QA Compliance
VITE_APP_VERSION=1.0.0

# API Configuration
VITE_API_BASE_URL=http://localhost:3001
VITE_APIFY_API_URL=http://localhost:3001

# Database Configuration
VITE_DB_HOST=localhost
VITE_DB_PORT=5432
VITE_DB_NAME=alcoa_qa_dev
VITE_DB_USER=dev_user

# Environment Settings
VITE_ENVIRONMENT=development
VITE_LOG_LEVEL=debug

# Optional: Additional Configuration
# VITE_DB_PASSWORD=your_password_here
# VITE_FEATURE_FLAGS=feature1,feature2
# VITE_AUTH_PROVIDER=oauth2

# Apify Configuration
APIFY_API_TOKEN=your_api_token_here
MCP_LOG_LEVEL=info
PORT=3001
NODE_ENV=development

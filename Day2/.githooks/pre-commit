#!/bin/bash

# ALCOA+ QA Application - Pre-commit Hook
# Validates environment configuration and database connectivity for local testing

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}[Pre-commit] Validating ALCOA+ QA Environment...${NC}"

# Check if .env file exists
if [ ! -f .env ]; then
    echo -e "${RED}✗ Error: .env file not found${NC}"
    echo "  Run: cp .env.example .env"
    exit 1
fi

# Check if .env.production file exists
if [ ! -f .env.production ]; then
    echo -e "${RED}✗ Error: .env.production file not found${NC}"
    echo "  Run: cp .env.example .env.production"
    exit 1
fi

# Function to check env variable exists
check_env_var() {
    local var_name=$1
    local file=$2

    if ! grep -q "^${var_name}=" "$file"; then
        echo -e "${RED}✗ Missing required variable: ${var_name} in ${file}${NC}"
        return 1
    fi
    return 0
}

# Required environment variables
REQUIRED_VARS=(
    "VITE_APP_NAME"
    "VITE_API_BASE_URL"
    "VITE_DB_HOST"
    "VITE_DB_PORT"
    "VITE_DB_NAME"
    "VITE_ENVIRONMENT"
)

# Validate all required variables
VALIDATION_FAILED=0
for var in "${REQUIRED_VARS[@]}"; do
    if ! check_env_var "$var" ".env"; then
        VALIDATION_FAILED=1
    fi
done

# Verify .env.production has localhost configured for testing
if grep -q "^VITE_DB_HOST=localhost" .env.production; then
    echo -e "${GREEN}✓ Production env configured for local testing (localhost)${NC}"
else
    echo -e "${YELLOW}! Warning: .env.production may not point to localhost${NC}"
    echo "  For local testing, ensure: VITE_DB_HOST=localhost"
fi

# Check node_modules exists
if [ ! -d "node_modules" ]; then
    echo -e "${YELLOW}! Warning: node_modules not found. Run: npm install${NC}"
fi

# Validate package.json and package-lock.json are in sync
if [ -f "package-lock.json" ]; then
    if ! npm ci --dry-run > /dev/null 2>&1; then
        echo -e "${YELLOW}! Warning: package-lock.json may be out of sync${NC}"
    fi
fi

if [ $VALIDATION_FAILED -eq 1 ]; then
    echo -e "${RED}✗ Pre-commit validation failed${NC}"
    exit 1
fi

echo -e "${GREEN}✓ Environment validation passed${NC}"
echo -e "${GREEN}✓ Database host: localhost${NC}"
echo -e "${GREEN}✓ Ready for local testing${NC}"

exit 0

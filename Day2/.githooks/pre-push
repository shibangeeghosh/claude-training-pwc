#!/bin/bash

# ALCOA+ QA Application - Pre-push Hook
# Validates code formatting and prevents pushing unformatted code

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}[Pre-push] Validating code format...${NC}"

# Check for unformatted JavaScript/JSX files
echo -e "${YELLOW}Checking for unformatted code...${NC}"

UNFORMATTED_FILES=()
ISSUES_FOUND=0

# Patterns to detect unformatted code
UNFORMATTED_PATTERNS=(
  '^\s*console\.log'           # Debug console.log statements
  '^\s*var\s'                   # Old var declarations
  '\s{3,}[^\s]'                # Excessive indentation (>2 spaces)
  ';\s*$'                       # Unnecessary semicolons at line end
)

# Check staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(js|jsx)$' || true)

if [ -z "$STAGED_FILES" ]; then
  echo -e "${GREEN}✓ No JavaScript files to check${NC}"
else
  while IFS= read -r file; do
    # Skip if file doesn't exist (deleted files)
    [ ! -f "$file" ] && continue

    # Check for console.log statements (common debug code)
    if grep -qn "console\.log" "$file" 2>/dev/null; then
      UNFORMATTED_FILES+=("$file (contains console.log)")
      ISSUES_FOUND=1
    fi

    # Check for var declarations (use const/let)
    if grep -qn "^\s*var\s" "$file" 2>/dev/null; then
      UNFORMATTED_FILES+=("$file (uses var instead of const/let)")
      ISSUES_FOUND=1
    fi

    # Check for TODO/FIXME comments (incomplete work)
    if grep -qin "TODO\|FIXME" "$file" 2>/dev/null; then
      echo -e "${YELLOW}⚠ Warning: $file contains TODO/FIXME comments${NC}"
    fi
  done <<< "$STAGED_FILES"
fi

# Report findings
if [ $ISSUES_FOUND -eq 0 ]; then
  echo -e "${GREEN}✓ Code format validation passed${NC}"
  echo -e "${GREEN}✓ No unformatted code detected${NC}"
else
  echo -e "${RED}✗ Unformatted code detected:${NC}"
  for file in "${UNFORMATTED_FILES[@]}"; do
    echo -e "${RED}  • $file${NC}"
  done
  echo ""
  echo -e "${YELLOW}To fix and retry:${NC}"
  echo -e "  1. Remove debug code (console.log, debugger statements)"
  echo -e "  2. Use const/let instead of var"
  echo -e "  3. Complete any TODO/FIXME work or remove comments"
  echo -e "  4. Stage changes: git add ."
  echo -e "  5. Retry push: git push${NC}"
  echo ""
  echo -e "${YELLOW}To push anyway (not recommended):${NC}"
  echo -e "  git push --no-verify${NC}"
  exit 1
fi

# Verify build succeeds
echo -e "${YELLOW}Verifying build...${NC}"
if npm run build > /dev/null 2>&1; then
  echo -e "${GREEN}✓ Build successful${NC}"
else
  echo -e "${RED}✗ Build failed${NC}"
  echo "  Fix build errors before pushing"
  exit 1
fi

echo -e "${GREEN}✓ Pre-push validation passed${NC}"
echo -e "${GREEN}✓ Ready to push${NC}"

exit 0

#!/bin/bash

# ALCOA+ QA Application - Pre-commit Async/Await Hook
# Validates all API handlers use async/await pattern instead of callbacks/promises

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}[Pre-commit] Validating async/await pattern usage...${NC}"

# Check for API handler files
API_DIR="src/api"
if [ ! -d "$API_DIR" ]; then
  echo -e "${GREEN}✓ No API directory found${NC}"
  exit 0
fi

ISSUES_FOUND=0
VIOLATIONS=()

# Check API files for proper async/await usage
check_async_patterns() {
  local file=$1
  local line_num=0
  local in_function=0
  local function_name=""

  while IFS= read -r line; do
    ((line_num++))

    # Detect function declarations
    if grep -qE "^export const|^const|^function|^async function" <<< "$line"; then
      function_name=$(echo "$line" | sed -E 's/^(export )?(async )?const ([a-zA-Z_][a-zA-Z0-9_]*).*/\3/')
      in_function=1
    fi

    # Check API handler functions should be async
    if [ "$in_function" = "1" ]; then
      # Check for .then() callbacks (promise chain)
      if grep -qE "\.then\(" <<< "$line"; then
        VIOLATIONS+=("$file:$line_num - Use async/await instead of .then() chain")
        ISSUES_FOUND=1
      fi

      # Check for .catch() (use try-catch with async/await)
      if grep -qE "\.catch\(" <<< "$line"; then
        VIOLATIONS+=("$file:$line_num - Use async/await with try-catch instead of .catch()")
        ISSUES_FOUND=1
      fi

      # Check for callback functions (err, result)
      if grep -qE "function.*\(.*err.*," <<< "$line" || grep -qE "=>.*err.*," <<< "$line"; then
        VIOLATIONS+=("$file:$line_num - Use async/await instead of callback pattern")
        ISSUES_FOUND=1
      fi

      # Check for Promise constructor
      if grep -qE "new Promise\(" <<< "$line"; then
        VIOLATIONS+=("$file:$line_num - Wrap in async function instead of using Promise constructor")
        ISSUES_FOUND=1
      fi

      # Look for end of function (dedent)
      if [ "$in_function" = "1" ] && grep -qE "^}" <<< "$line"; then
        in_function=0
      fi
    fi

  done < "$file"
}

# Find all API handler files
HANDLER_FILES=$(find "$API_DIR" -type f -name "*.js" ! -name "index.js" 2>/dev/null || true)

if [ -z "$HANDLER_FILES" ]; then
  echo -e "${GREEN}✓ No API handler files found${NC}"
  exit 0
fi

echo -e "${YELLOW}Checking for proper async/await usage...${NC}"

while IFS= read -r file; do
  [ -z "$file" ] && continue
  check_async_patterns "$file"
done <<< "$HANDLER_FILES"

# Report findings
if [ $ISSUES_FOUND -eq 0 ]; then
  echo -e "${GREEN}✓ All API handlers use async/await pattern${NC}"
  echo -e "${GREEN}✓ No callback or promise chains detected${NC}"
else
  echo -e "${RED}✗ Async/await pattern violations detected:${NC}"
  echo ""
  for violation in "${VIOLATIONS[@]}"; do
    echo -e "${RED}  • $violation${NC}"
  done
  echo ""
  echo -e "${YELLOW}Guidelines:${NC}"
  echo -e "  ✓ Use: async function handler() { const result = await api.call() }"
  echo -e "  ✗ Don't: handler().then(result => {...}).catch(err => {...})"
  echo -e "  ✓ Use: try { ... } catch(err) { ... }"
  echo -e "  ✗ Don't: .catch(err => handle(err))"
  echo ""
  exit 1
fi

echo -e "${GREEN}✓ Async/await validation passed${NC}"
exit 0

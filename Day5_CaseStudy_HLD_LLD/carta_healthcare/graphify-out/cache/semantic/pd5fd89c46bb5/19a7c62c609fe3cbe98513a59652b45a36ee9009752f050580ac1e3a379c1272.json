{"nodes": [{"id": "claude_overview", "label": "Carta Healthcare CLAUDE.md Project Instructions", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_source_span_invariant", "label": "Source-Span Verification Invariant", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents any field from being trusted solely on LLM output; extraction_engine.py independently re-checks the quoted excerpt occurs verbatim in the raw document before acceptance."}, {"id": "claude_api_key_invariant", "label": "Groq API Key Never Persisted Invariant", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps the Groq key out of any durable artifact (disk, logs, audit trail) so a compromised log/audit file can never leak credentials; key lives only in the Flask session and outbound Authorization header."}, {"id": "claude_cross_check_override_invariant", "label": "Cross-Check Disagreement Forces Exception Invariant", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A sampled dual-extraction disagreement is the strongest available accuracy signal, so it must override any other passing check rather than being averaged away."}, {"id": "claude_rag_grounded_normalization_invariant", "label": "RAG-Grounded Normalization Invariant", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Constrains the LLM to retrieved candidates only so coding-standard mapping is grounded rather than a guess; below-threshold candidates route to exception instead of a fabricated code."}, {"id": "claude_normalizedfield_provenance_invariant", "label": "NormalizedField Provenance Invariant", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recording coding_reference_version and spec_version keeps registry submissions reproducible under audit even as coding standards and specs evolve."}, {"id": "claude_exception_resolution_invariant", "label": "Explicit Abstractor Resolution Invariant", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exceptions exist because automation was insufficiently confident; auto-resolving them would defeat the purpose of the human-in-the-loop fail-safe."}, {"id": "claude_synthetic_data_invariant", "label": "Synthetic-Only Sample Data Invariant", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sample/reference data must stay synthetic so the POC never handles real PHI outside a governed production deployment."}, {"id": "claude_config_driven_design", "label": "Config-Driven Design Principle", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_context_trimming_policy", "label": "Context Trimming Policy", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps sub-agents focused on the current change rather than re-deriving already-resolved context as transcripts grow."}, {"id": "claude_phi_guard_hook", "label": "check_phi_guard.py Independent Enforcement Layer", "file_typ
# FLASK_SECRET_KEY: session signing key. Optional; a dev default is used if unset.
FLASK_SECRET_KEY=

# Note: the Groq API key is NOT an env var in this app. It is entered through the
# /api-key UI step and lives only in the Flask session for that browser session -
# it is never read from the environment, written to disk, or logged.

# OTEL_EXPORTER_OTLP_ENDPOINT / OTEL_SERVICE_NAME: optional OpenTelemetry settings, only
# used if you start the app via start_observability.sh (or set them yourself). Defaults
# below match the ports docker-compose.yaml exposes for this project.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4327
OTEL_SERVICE_NAME=carta-healthcare-clinical-extraction
